# Release signing configuration for Android
# Copy this file to key.properties and fill in your values.
# DO NOT commit key.properties to version control.

storeFile=../pxlpxl-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=pxlpxl
keyPassword=YOUR_KEY_PASSWORD

# To generate a keystore:
# keytool -genkey -v -keystore pxlpxl-release.keystore -alias pxlpxl -keyalg RSA -keysize 2048 -validity 10000
